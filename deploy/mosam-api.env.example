# Copie vers ~/mosam-api.env sur la VM, remplace les valeurs vides.
# Ne commite jamais mosam-api.env (secrets).
# Pooler Supabase : Dashboard → Connect → session mode, port 5432 ou 6543 selon ta config.

OPENAI_API_KEY=
MOSAM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

SUPABASE_DB_URL=
SUPABASE_DB_POOLER_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Agent ChatGPT-like : identifie le produit (nom, usage, matieres) avant classification TEC.
# N'impose jamais de code SH — la classification releve du moteur TEC local.
MOSAM_PRODUCT_IDENTIFICATION_ENABLED=true

# Recherche internet OpenAI (Responses API + outil web_search) pour les saisies courtes.
# Utilise la meme OPENAI_API_KEY ; facturation supplementaire par appel de recherche.
MOSAM_WEB_SEARCH_ENABLED=true
# MOSAM_WEB_SEARCH_MODEL=gpt-4.1-mini
# MOSAM_WEB_SEARCH_CONTEXT_SIZE=medium
# MOSAM_WEB_SEARCH_TIMEOUT_SECONDS=90
