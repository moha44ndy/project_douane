# Copie vers ~/mosam-api.env sur la VM, remplace les valeurs vides.
# Ne commite jamais mosam-api.env (secrets).
# Pooler Supabase (OBLIGATOIRE sur Windows / reseau IPv4-only) :
# Dashboard → Connect → Session pooler
# Ex. aws-1-eu-west-1.pooler.supabase.com:5432, user postgres.VOTRE_REF
# Reparation : python sam/scripts/fix_supabase_pooler_env.py

OPENAI_API_KEY=
MOSAM_MODEL=gpt-4.1-mini
# Optional cost-control routing:
# keep the stronger model in MOSAM_CLASSIFICATION_MODEL
# and provide a cheaper model for simple classification cases below.
MOSAM_CLASSIFICATION_MODEL=
MOSAM_CLASSIFICATION_MODEL_CHEAP=
# off | auto
MOSAM_CLASSIFICATION_MODEL_ROUTING=off
MOSAM_CLASSIFICATION_ROUTING_MAX_PROMPT_CHARS=20000
MOSAM_CLASSIFICATION_MAX_OUTPUT_TOKENS=4096
# Structured table submissions above this count are split into smaller LLM batches.
MOSAM_STRUCTURED_FORM_BATCH_SIZE=3
MOSAM_REFERENCE_PARALLELISM=2
EMBEDDING_MODEL=text-embedding-3-small
MOSAM_FAISS_TOP_K=16
MOSAM_MAX_CANDIDATE_POSITIONS=8
MOSAM_TEC_EXCERPT_MAX_CHARS=180
MOSAM_TEC_SUBPOSITIONS_MAX_ITEMS=8
MOSAM_TEC_CONTEXT_COMPACT=true

SUPABASE_DB_URL=
SUPABASE_DB_POOLER_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Agent ChatGPT-like : identifie le produit (nom, usage, matieres) avant classification TEC.
# N'impose jamais de code SH — la classification releve du moteur TEC local.
MOSAM_PRODUCT_IDENTIFICATION_ENABLED=true

# Recherche internet OpenAI (Responses API + outil web_search) pour les saisies courtes.
# Utilise la meme OPENAI_API_KEY ; facturation supplementaire par appel de recherche.
MOSAM_WEB_SEARCH_ENABLED=true
# Policy:
# - auto: web search only for manufacturer refs and very short ambiguous queries
# - manufacturer_only: web search only for part numbers / technical references
# - always: keep old broader behavior
# - never: disable web search entirely
MOSAM_WEB_SEARCH_POLICY=auto
# Thresholds used when policy=auto
MOSAM_WEB_SEARCH_MAX_SHORT_QUERY_WORDS=3
MOSAM_WEB_SEARCH_MAX_SHORT_QUERY_CHARS=40
# MOSAM_WEB_SEARCH_MODEL=gpt-4.1-mini
# MOSAM_WEB_SEARCH_CONTEXT_SIZE=low
# MOSAM_WEB_SEARCH_TIMEOUT_SECONDS=90
MOSAM_RAG_EXTRA_SEARCHES_ENABLED=false
MOSAM_RAG_HEADING_MATCH_ENABLED=true
